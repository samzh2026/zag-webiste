  res.json(store.getAllSettings());
});
app.put("/api/admin/settings", requireAuth, (req, res) => {
  try {
    for (const [k, v] of Object.entries(req.body || {})) {
      store.setSetting(k, String(v));
    }
    res.json(store.getAllSettings());
  } catch (e) { res.status(400).json({ error: e.message }); }
});

// Admin - Import
app.post("/api/admin/import", requireAuth, (req, res) => {
  try {
    const { products } = req.body || {};
    if (!Array.isArray(products)) return res.status(400).json({ error: "products array required" });
    let imported = 0;
    for (const p of products) {
      if (p.sku && store.getProducts ? store.getProducts({}).some(ep => ep.sku === p.sku) : false) continue;
      store.createProduct(p);
      imported++;
    }
    res.json({ ok: true, imported });
  } catch (e) { res.status(400).json({ error: e.message }); }
});

app.get("/api/admin/export-csv", requireAuth, (_req, res) => {
  res.json(store.exportCrossReferencesCSV());
});

// ---- Static Files ----
app.use(express.static(ROOT, {
  maxAge: "1d",
  setHeaders: (res, filePath) => {
    if (filePath.endsWith(".html")) res.setHeader("Cache-Control", "no-cache");
  }
}));

// ---- Fallback (SPA) ----
app.get("*", (req, res) => {
  if (req.path.startsWith("/api/")) {
    return res.status(404).json({ error: "API route not found" });
  }
  const indexPath = path.join(ROOT, "index.html");
  if (fs.existsSync(indexPath)) {
    res.sendFile(indexPath);
  } else {
    res.status(404).send("Not found");
  }
});

// ---- Error Handling ----
app.use((err, _req, res, _next) => {
  console.error("Server error:", err.message);
  res.status(500).json({ error: "Internal server error" });
});

// ---- Start Server ----
app.listen(PORT, () => {
  console.log(`ZAG BRAKES Platform running at http://localhost:${PORT}`);
  console.log(`Admin: http://localhost:${PORT}/admin.html`);
  console.log(`Database: data/zag.db`);
});

// Helper to access db for image cleanup
function db() {
  return store.initDatabase ? store.initDatabase() : null;
}

module.exports = app;
