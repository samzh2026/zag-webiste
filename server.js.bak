// Admin dashboard
app.get("/api/admin/dashboard", requireAuth, (_req, res) => {
  res.json(store.getDashboardStats());
});

// Admin catalog (full, matches old admin.html camelCase format)
app.get("/api/admin/catalog", requireAuth, (_req, res) => {
  const categories = store.getCategories().map(c => {
    c = flattenToEn(c, CATEGORY_LOCALE_FIELDS);
    return {
      id: c.id,
      name: c.name,
      description: c.description,
      slug: c.slug,
      sortOrder: c.sort_order,
      seoTitle: c.seo_title,
      seoDesc: c.seo_desc,
      seoKeywords: c.seo_keywords,
      createdAt: c.created_at,
      updatedAt: c.updated_at
    };
  });
  const products = store.getProducts({ status: "all" }).map(p => {
    const images = store.getProductById ? store.getProductById(p.id)?.images || [] : [];
    p = flattenToEn(p, PRODUCT_LOCALE_FIELDS);
    return {
      id: p.id,
      sku: p.sku,
      name: p.name,
      brand: p.brand,
      categoryId: p.category_id,
      material: p.material,
      description: p.description,
      specifications: p.specifications,
      length: p.length,
      width: p.width,
      thickness: p.thickness,
      status: p.status,
      sortOrder: p.sort_order,
      images: images.map(img => img.url),
      createdAt: p.created_at,
      updatedAt: p.updated_at
    };
  });
  res.json({ categories, products });
});

// Admin CRUD - Categories
app.post("/api/admin/categories", requireAuth, (req, res) => {
  try {
    const cat = store.createCategory(req.body);
    res.json(cat);
  } catch (e) { res.status(400).json({ error: e.message }); }
});
app.put("/api/admin/categories/:id", requireAuth, (req, res) => {
  try {
    const cat = store.updateCategory(req.params.id, req.body);
    if (!cat) return res.status(404).json({ error: "Not found" });
    res.json(cat);
  } catch (e) { res.status(400).json({ error: e.message }); }
});
app.delete("/api/admin/categories/:id", requireAuth, (req, res) => {
  const result = store.deleteCategory(req.params.id);
  if (result.error) return res.status(400).json(result);
  res.json(result);
});

// Admin CRUD - Products
app.post("/api/admin/products", requireAuth, upload.any(), (req, res) => {
  try {
    const body = { ...req.body };
    if (body.categoryId) { body.categoryId = body.categoryId; delete body.category_id; }
    const product = store.createProduct(body);
    if (req.files && req.files.length > 0) {
      for (const file of req.files) {
        const url = "/uploads/" + file.filename;
        store.addProductImage(product.id, url);
      }
    }
    res.json(store.getProductById(product.id));
  } catch (e) { res.status(400).json({ error: e.message }); }
});
app.put("/api/admin/products/:id", requireAuth, upload.any(), (req, res) => {
  try {
    if (req.body.categoryId) { req.body.categoryId = req.body.categoryId; }
    const product = store.updateProduct(req.params.id, req.body);
    if (!product) return res.status(404).json({ error: "Not found" });
    if (req.files && req.files.length > 0) {
      for (const file of req.files) {
        const url = "/uploads/" + file.filename;
        store.addProductImage(product.id, url);
      }
    }
    res.json(store.getProductById(product.id));
  } catch (e) { res.status(400).json({ error: e.message }); }
});
app.delete("/api/admin/products/:id", requireAuth, (req, res) => {
  store.deleteProduct(req.params.id);
  res.json({ ok: true });
});

