// Admin - Users
app.get("/api/admin/users", requireAuth, (_req, res) => {
  res.json(store.getUsers());
});
app.post("/api/admin/users", requireAuth, (req, res) => {
  const { username, password, role } = req.body;
  if (!username || !password) return res.status(400).json({ error: "Username and password required" });
  const hash = crypto.createHash("sha256").update(password).digest("hex");
  const user = store.createUser(username, hash, role || "admin");
  res.json(user);
});
app.put("/api/admin/users/:id/password", requireAuth, (req, res) => {
  if (!req.body.password) return res.status(400).json({ error: "Password required" });
  const hash = crypto.createHash("sha256").update(req.body.password).digest("hex");
  store.updateUserPassword(req.params.id, hash);
  res.json({ ok: true });
});
app.delete("/api/admin/users/:id", requireAuth, (req, res) => {
  store.deleteUser(req.params.id);
  res.json({ ok: true });
});

