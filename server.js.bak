// =============================================================================
// server.js - ZAG BRAKES Platform (Express + SQLite)
// =============================================================================
// Start:  node server.js
// Dev:    node --watch server.js
// =============================================================================

require("dotenv").config();

const express = require("express");
const cors = require("cors");
const multer = require("multer");
const path = require("path");
const crypto = require("crypto");
const fs = require("fs");

const store = require("./lib/store");
const { requireAuth, handleLogin } = require("./lib/auth");
const { langMiddleware } = require("./lib/lang");

// ---- Config ----
const PORT = Number(process.env.PORT || 3000);
const ROOT = __dirname;
const UPLOAD_DIR = path.join(ROOT, "uploads");
fs.mkdirSync(UPLOAD_DIR, { recursive: true });

// ---- Express App ----
const app = express();

// CORS (allow admin and public access)
app.use(cors());

// Body parsing
app.use(express.json({ limit: "10mb" }));
app.use(express.urlencoded({ extended: true }));

// Multi-language middleware (reads ?lang=)
app.use(langMiddleware);

// File upload (multer)
const storage = multer.diskStorage({
  destination: UPLOAD_DIR,
  filename: (_req, file, cb) => {
    const safeExt = [".jpg", ".jpeg", ".png", ".webp", ".gif"].includes(
      path.extname(file.originalname).toLowerCase()
    ) ? path.extname(file.originalname).toLowerCase() : ".bin";
    cb(null, `${Date.now()}-${crypto.randomBytes(5).toString("hex")}${safeExt}`);
  }
});
const upload = multer({ storage, limits: { fileSize: 5 * 1024 * 1024 } }); // 5 MB

// ---- Helpers ----

/** Parse locale JSON string -> object */
function parseLocale(raw) {
  if (!raw) return {};
  if (typeof raw === "object") return raw;
  try { return JSON.parse(raw); } catch (_) { return { en: String(raw) }; }
}

/** Flatten locale fields in an object to English (for admin display) */
function flattenToEn(obj, fields) {
  const result = { ...obj };
  for (const f of fields) {
    if (result[f]) result[f] = parseLocale(result[f]).en || "";
  }
  return result;
}

/** Flatten locale fields using req.locale (for public API) */
function flattenToLang(req, obj, fields) {
  const result = { ...obj };
  for (const f of fields) {
    if (result[f]) result[f] = req.locale(result[f]);
  }
  return result;
}

const PRODUCT_LOCALE_FIELDS = ["name", "material", "description", "specifications"];
const CATEGORY_LOCALE_FIELDS = ["name", "description", "seo_title", "seo_desc", "seo_keywords"];

// ---- Public API Routes ----

// Health
app.get("/api/health", (_req, res) => {
  res.json({ ok: true, time: new Date().toISOString() });
});

// Login
app.post("/api/login", handleLogin);

// Product detail
app.get("/api/products/:id", (req, res) => {
  const product = store.getProductById(req.params.id);
  if (!product) return res.status(404).json({ error: "Product not found" });
  let p = flattenToLang(req, product, PRODUCT_LOCALE_FIELDS);
  if (p.category) p.category = flattenToLang(req, p.category, ["name", "description"]);
  p.images = (product.images || []).map(function(i) { return i.url; });
  p.vehicles = (product.vehicles || []).map(function(v) { return {make:req.locale(v.make_name),model:req.locale(v.model_name),year:v.year,engine:v.displacement||'N/A',position:v.position}; });
  res.json(p);
});

// Public catalog (with pagination)
app.get("/api/catalog", (req, res) => {
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 12;
  const data = store.getPublicCatalog({
    category: req.query.category,
    q: req.query.q
  });

  // Flatten locale fields for front-end
  data.categories = data.categories.map(c =>
    flattenToLang(req, c, ["name", "description"])
  );
  data.products = data.products.map(p => {
    p = flattenToLang(req, p, PRODUCT_LOCALE_FIELDS);
    if (p.category) p.category = flattenToLang(req, p.category, ["name", "description"]);
    return p;
  });

  // Pagination
  const total = data.products.length;
  const totalPages = Math.ceil(total / limit);
  const start = (page - 1) * limit;
  data.products = data.products.slice(start, start + limit);
  data.pagination = { page, limit, total, totalPages };

  res.json(data);
});

// Public categories
app.get("/api/categories", (req, res) => {
  const categories = store.getCategories().map(c =>
    flattenToLang(req, c, ["name", "description"])
  );
  res.json(categories);
});

// Vehicle hierarchy (public)
app.get("/api/vehicles", (req, res) => {
  const { make, model, year } = req.query;

  if (make) {
    const makes = store.getMakes();
    const found = makes.find(m => {
      const name = parseLocale(m.name);
      return m.slug === make || (name.en || "").toLowerCase() === make.toLowerCase();
    });
    if (!found) return res.json([]);

    if (model) {
      const models = store.getModels(found.id);
      const foundModel = models.find(m => {
        const name = parseLocale(m.name);
        return m.slug === model || (name.en || "").toLowerCase() === model.toLowerCase();
      });
      if (!foundModel) return res.json([]);

      if (year) {
        const years = store.getYears(foundModel.id);
        const foundYear = years.find(y => String(y.year) === String(year));
        if (!foundYear) return res.json([]);

        const engines = store.getEngineSizes(foundYear.id);
        return res.json(engines.map(e => {
          const flat = flattenToLang(req, { name: found.name }, ["name"]);
          return { ...e, makeName: flat.name, modelName: parseLocale(foundModel.name).en };
        }));
      }
      const years = store.getYears(foundModel.id);
      return res.json(years.map(y => ({
        ...y,
        makeName: parseLocale(found.name).en,
        modelName: parseLocale(foundModel.name).en
      })));
    }
    const models = store.getModels(found.id);
    return res.json(models.map(m => ({
      ...m,
      makeName: parseLocale(found.name).en
    })));
  }
  res.json([]);
});

app.get("/api/vehicles/makes", (_req, res) => {
  const makes = store.getMakes().map(m =>
    flattenToLang(_req, m, ["name"])
  );
  res.json(makes);
});

app.get("/api/vehicles/models", (req, res) => {
  if (!req.query.makeId) return res.json([]);
  const models = store.getModels(req.query.makeId).map(m => {
    m = flattenToLang(req, m, ["name"]);
    return m;
  });
  res.json(models);
});

app.get("/api/vehicles/years", (req, res) => {
  if (!req.query.modelId) return res.json([]);
