  // ===== Image handling =====
  function resetImages() {
    pendingImages = [];
    existingImages = [];
    removedExisting = [];
    imageInput.value = "";
    renderImagePreviews();
  }

  function renderImagePreviews() {
    imagePreviews.innerHTML = "";
    existingImages.forEach(function (url, i) {
      if (removedExisting.indexOf(i) !== -1) return;
      var div = document.createElement("div");
      div.className = "image-preview";
      div.innerHTML = "<img src=\"" + esc(url) + "?t=" + Date.now() + "\" alt=\"\"><button class=\"remove-img\" data-existing=\"" + i + "\">&times;</button><span class=\"img-label\">Existing " + (i + 1) + "</span>";
      imagePreviews.appendChild(div);
    });
    pendingImages.forEach(function (img, i) {
      var div = document.createElement("div");
      div.className = "image-preview";
      div.innerHTML = "<img src=\"" + img.dataUrl + "\" alt=\"\"><button class=\"remove-img\" data-pending=\"" + i + "\">&times;</button><span class=\"img-label\">New " + (existingImages.filter(function (_, j) { return removedExisting.indexOf(j) === -1; }).length + i + 1) + "</span>";
      imagePreviews.appendChild(div);
    });
    var totalVisible = existingImages.filter(function (_, i) { return removedExisting.indexOf(i) === -1; }).length + pendingImages.length;
    uploadZone.style.display = totalVisible >= MAX_IMAGES ? "none" : "";
  }

  uploadZone.addEventListener("click", function () { imageInput.click(); });
  imageInput.addEventListener("change", function () {
    addFiles(Array.from(imageInput.files));
    imageInput.value = "";
  });
  uploadZone.addEventListener("dragover", function (e) { e.preventDefault(); uploadZone.classList.add("drag-over"); });
  uploadZone.addEventListener("dragleave", function () { uploadZone.classList.remove("drag-over"); });
  uploadZone.addEventListener("drop", function (e) {
    e.preventDefault();
    uploadZone.classList.remove("drag-over");
    addFiles(Array.from(e.dataTransfer.files));
  });

  function addFiles(files) {
    var remaining = MAX_IMAGES - (existingImages.filter(function (_, i) { return removedExisting.indexOf(i) === -1; }).length + pendingImages.length);
    files = files.filter(function (f) { return f.type.startsWith("image/"); }).slice(0, remaining);
    files.forEach(function (file) {
      var reader = new FileReader();
      reader.onload = function (ev) {
        pendingImages.push({ file: file, dataUrl: ev.target.result });
        renderImagePreviews();
      };
      reader.readAsDataURL(file);
    });
  }

  // Paste image support (Ctrl+V)
  productForm.addEventListener("paste", function (e) {
    var items = (e.clipboardData || window.clipboardData).items;
    if (!items) return;
    var pastedFiles = [];
    for (var i = 0; i < items.length; i++) {
      if (items[i].type.indexOf("image") !== -1) {
        var blob = items[i].getAsFile();
        if (blob) {
          var ext = blob.type.split("/")[1] || "png";
          var renamedFile = new File([blob], "pasted-" + Date.now() + "." + ext, { type: blob.type });
          pastedFiles.push(renamedFile);
        }
      }
    }
    if (pastedFiles.length > 0) {
      e.preventDefault();
      addFiles(pastedFiles);
    }
  });

  imagePreviews.addEventListener("click", function (e) {
    var btn = e.target.closest(".remove-img");
    if (!btn) return;
    e.preventDefault();
    if (btn.dataset.existing !== undefined) {
      removedExisting.push(parseInt(btn.dataset.existing));
    }
    if (btn.dataset.pending !== undefined) {
      pendingImages.splice(parseInt(btn.dataset.pending), 1);
    }
    renderImagePreviews();
  });

