                return (mk + " " + md + " " + (v.position||"F") + " " + (v.year||"")).trim();
              }).join("\n");
            }
          }
        } catch(fe) { console.error("Failed to load full product data:", fe); }

        renderImagePreviews();
        showProductForm(true);
      }
    }
    if (delBtn && confirm("Delete this product permanently?")) {
      try {
        await api("/api/admin/products/" + delBtn.dataset.deleteProduct, { method: "DELETE" });
        await loadCatalog();
        msg(productMessage, "Product deleted", "success");
