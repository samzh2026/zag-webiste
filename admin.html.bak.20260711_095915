  // Edit / Delete from table
  productRows.addEventListener("click", async function (e) {
    var editBtn = e.target.closest("[data-edit-product]");
    var delBtn = e.target.closest("[data-delete-product]");
    if (editBtn) {
      var editId = editBtn.dataset.editProduct;
      var product = catalog.products.find(function (p) { return p.id === editId; });
      if (product) {
        resetImages();
        existingImages = (product.images || []).slice();
        pendingFitments = [];
        renderFitmentTags();
        Object.keys(product).forEach(function (key) {
          if (!productForm.elements[key] || key === "images" || key === "image" || key === "id") return;
          productForm.elements[key].value = Array.isArray(product[key]) ? product[key].join("\n") : (product[key] || "");
        });
        productForm.querySelector("[name=id]").value = product.id;

        // 加载完整数据：EBC号码 + Features/APPLICATION
        try {
          var fResp = await fetch("/api/admin/products/" + editId, { headers: { Authorization: "Bearer " + token() } });
          var fullProduct = await fResp.json();

          // 回填EBC号码
          if (fullProduct.crossRefs && fullProduct.crossRefs.length > 0) {
            var ebcRef = fullProduct.crossRefs.find(function(r) { return r.ref_type === "EBC"; });
            if (ebcRef && productForm.elements["ebcNumber"]) {
              productForm.elements["ebcNumber"].value = ebcRef.ref_number || "";
            }
          }

          // 回填Features（优先用specifications.features，没有则从vehicles生成）
          var specs = fullProduct.specifications;
          if (typeof specs === "string") { try { specs = JSON.parse(specs); } catch(e) { specs = {}; } }
          var featEl = productForm.elements["features"];
          if (featEl) {
            if (specs && specs.features && Array.isArray(specs.features) && specs.features.length > 0) {
              featEl.value = specs.features.join("\n");
            } else if (fullProduct.vehicles && fullProduct.vehicles.length > 0) {
              featEl.value = fullProduct.vehicles.map(function(v) {
                var mk = v.make_name ? (JSON.parse(v.make_name).en || v.make_name) : "";
