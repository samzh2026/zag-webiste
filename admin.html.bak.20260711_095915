        "<td data-label=\"Name\">" + esc(c.name) + "</td>" +
        "<td data-label=\"Slug\">" + esc(c.slug) + "</td>" +
        "<td data-label=\"Products\">" + (counts[c.id] || 0) + "</td>" +
        "<td data-label=\"Actions\"><div class=\"toolbar\">" +
        "<button class=\"secondary small\" type=\"button\" data-edit-category=\"" + esc(c.id) + "\">Edit</button>" +
        "<button class=\"danger small\" type=\"button\" data-delete-category=\"" + esc(c.id) + "\">Del</button>" +
        "</div></td></tr>";
    }).join("");
  }

  categoryForm.addEventListener("submit", async function (e) {
    e.preventDefault();
    var fd = new FormData(categoryForm);
    var vals = {}; fd.forEach(function (v, k) { vals[k] = v; });
    var id = vals.id; delete vals.id;
    try {
      await api(id ? "/api/admin/categories/" + id : "/api/admin/categories", {
        method: id ? "PUT" : "POST",
        body: JSON.stringify(vals)
      });
      categoryForm.reset();
      await loadCatalog();
      msg(document.getElementById("categoryMessage"), "Category saved", "success");
    } catch (err) { msg(document.getElementById("categoryMessage"), err.message, "error"); }
  });

  document.getElementById("resetCategoryBtn").addEventListener("click", function () { categoryForm.reset(); });

  categoryRows.addEventListener("click", async function (e) {
    var editBtn = e.target.closest("[data-edit-category]");
    var delBtn = e.target.closest("[data-delete-category]");
    if (editBtn) {
      var cat = catalog.categories.find(function (c) { return c.id === editBtn.dataset.editCategory; });
      if (cat) {
        Object.keys(cat).forEach(function (k) {
          if (categoryForm.elements[k]) categoryForm.elements[k].value = cat[k] || "";
        });
      }
    }
    if (delBtn && confirm("Delete this category?")) {
      try {
        await api("/api/admin/categories/" + delBtn.dataset.deleteCategory, { method: "DELETE" });
        await loadCatalog();
        msg(document.getElementById("categoryMessage"), "Category deleted", "success");
      } catch (err) { msg(document.getElementById("categoryMessage"), err.message, "error"); }
    }
  });

  // ===== CSV Import =====
  var csvRows = [];
  var csvUploadZoneEl = document.getElementById("csvUploadZone");
  var csvFileInputEl = document.getElementById("csvFileInput");

  if (csvUploadZoneEl && csvFileInputEl) {
    csvUploadZoneEl.addEventListener("click", function () {
      csvFileInputEl.click();
    });
    csvUploadZoneEl.addEventListener("dragover", function (e) { e.preventDefault(); });
    csvUploadZoneEl.addEventListener("drop", function (e) {
      e.preventDefault();
      var file = e.dataTransfer.files[0];
      if (file) parseCSV(file);
    });
    csvFileInputEl.addEventListener("change", function () {
      if (this.files[0]) parseCSV(this.files[0]);
      this.value = "";
    });
  }

  function parseCSV(file) {
    var reader = new FileReader();
    reader.onload = function (e) {
      var text = e.target.result;
      if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1);
      var lines = text.split(/\r?\n/).filter(function (l) { return l.trim(); });
      if (lines.length < 2) { alert("CSV must have a header row + data rows"); return; }

      var headers = parseCSVLine(lines[0]);
      csvRows = [];
      for (var i = 1; i < lines.length; i++) {
        var vals = parseCSVLine(lines[i]);
        var row = {};
        headers.forEach(function (h, j) { row[h] = vals[j] || ""; });
        csvRows.push(row);
      }
      renderCSVPreview(headers);
    };
    reader.readAsText(file, "UTF-8");
  }

  function parseCSVLine(line) {
    var result = [];
    var current = "";
    var inQuotes = false;
    for (var i = 0; i < line.length; i++) {
      var ch = line[i];
      if (inQuotes) {
        if (ch === '"' && line[i + 1] === '"') { current += '"'; i++; }
        else if (ch === '"') { inQuotes = false; }
        else { current += ch; }
      } else {
        if (ch === '"') { inQuotes = true; }
        else if (ch === ',') { result.push(current.trim()); current = ""; }
        else { current += ch; }
      }
    }
    result.push(current.trim());
    return result;
  }

  function renderCSVPreview(headers) {
    var previewEl = document.getElementById("csvPreview");
    var rowCountEl = document.getElementById("csvRowCount");
    var tableEl = document.getElementById("csvPreviewTable");
    if (!previewEl || !rowCountEl || !tableEl) return;

    previewEl.style.display = "block";
    rowCountEl.textContent = csvRows.length + " row(s) ready to import";

    var html = "<thead><tr>";
    headers.forEach(function (h) { html += "<th>" + esc(h) + "</th>"; });
    html += "</tr></thead><tbody>";

    var preview = csvRows.slice(0, 10);
    preview.forEach(function (row) {
      html += "<tr>";
      headers.forEach(function (h) { html += "<td>" + esc(row[h] || "") + "</td>"; });
      html += "</tr>";
    });

    if (csvRows.length > 10) html += "<tr><td colspan=\"" + headers.length + "\" style=\"text-align:center;color:#888;\">... and " + (csvRows.length - 10) + " more rows</td></tr>";
    html += "</tbody>";
    tableEl.innerHTML = html;
  }

  var csvClearBtnEl = document.getElementById("csvClearBtn");
  if (csvClearBtnEl) {
    csvClearBtnEl.addEventListener("click", function () {
      csvRows = [];
      var previewEl = document.getElementById("csvPreview");
      var resultsEl = document.getElementById("importResults");
      if (previewEl) previewEl.style.display = "none";
      if (resultsEl) resultsEl.innerHTML = "";
    });
  }

  var csvImportBtnEl = document.getElementById("csvImportBtn");
  if (csvImportBtnEl) {
    csvImportBtnEl.addEventListener("click", async function () {
      if (csvRows.length === 0) return;
      var btn = document.getElementById("csvImportBtn");
      btn.disabled = true;
      btn.textContent = "Importing...";
      try {
        var result = await api("/api/admin/import", {
          method: "POST",
          body: JSON.stringify({ rows: csvRows })
        });
        var html = '<div class="message success">Imported: ' + result.created + ' | Skipped: ' + result.skipped;
        if (result.errors.length > 0) {
          html += ' | Errors: ' + result.errors.length;
          html += '<ul style="margin-top:8px;">';
          result.errors.forEach(function (e) { html += '<li style="font-size:12px;color:#c00;">' + esc(e.row) + ': ' + esc(e.error) + '</li>'; });
          html += '</ul>';
        }
        html += '</div>';
        var resultsEl = document.getElementById("importResults");
        if (resultsEl) resultsEl.innerHTML = html;
        if (result.created > 0) { await loadCatalog(); }
      } catch (err) {
        var importMessageEl = document.getElementById("importMessage");
        if (importMessageEl) msg(importMessageEl, err.message, "error");
      }
      btn.disabled = false;
      btn.textContent = "Import All";
    });
  }

  var downloadTemplateBtnEl = document.getElementById("downloadTemplateBtn");
  if (downloadTemplateBtnEl) {
    downloadTemplateBtnEl.addEventListener("click", function () {
      var csv = "SKU,Name,Category,Material,Make,Model,Year,Engine,Position,EBC Number,Description,Features\n";
      csv += "ZAG-PAD-001,Front Brake Pad,Brake Pads,Sintered,Honda,CBR600RR,2024,600cc,Front,FA123,\"High performance sintered pad\",\"Low noise|High heat resistance\"";
      var blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8" });
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url; a.download = "zag-import-template.csv";
      a.click();
      URL.revokeObjectURL(url);
    });
  }

  var exportCsvBtnEl = document.getElementById("exportCsvBtn");
  if (exportCsvBtnEl) {
    exportCsvBtnEl.addEventListener("click", function () {
      window.open("/api/admin/export-csv?token=" + encodeURIComponent(token()), "_blank");
    });
  }

  // ===== Init =====
  if (token()) {
    // Security: verify token on server before showing admin UI
    api("/api/admin/dashboard").then(function () {
      showAdmin();
      loadCatalog().catch(function (err) {
        console.error("Catalog load failed:", err);
      });
    }).catch(function () {
      localStorage.removeItem(tokenKey);
      showLogin();
    });
  } else {
    showLogin();
  }
})();
</script>
</body>
</html>



