  // Save product
  productForm.addEventListener("submit", async function (e) {
    e.preventDefault();
    var fd = new FormData(productForm);
    var id = fd.get("id");
    fd.delete("id");

    // Add fitments as JSON
    fd.set("fitments", JSON.stringify(pendingFitments));
    fd.set("ebcNumber", fd.get("ebcNumber") || "");

    // Append new images
    var finalExisting = existingImages.filter(function (_, i) { return removedExisting.indexOf(i) === -1; });
    pendingImages.forEach(function (img, i) {
      fd.append("image" + (finalExisting.length + i), img.file, img.file.name);
    });
    removedExisting.forEach(function (i) {
      fd.append("removeImage" + i, "1");
    });

    try {
      var result = await api(id ? "/api/admin/products/" + id : "/api/admin/products", {
        method: id ? "PUT" : "POST",
        body: fd
      });
      hideProductForm();
      await loadCatalog();
      alert(id ? "✓ Product updated successfully!" : "✓ Product added successfully!");
    } catch (err) {
      msg(productMessage, err.message, "error");
