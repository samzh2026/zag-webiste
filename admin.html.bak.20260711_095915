<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZAG BRAKES Admin</title>
  <style>
    :root {
      --red: #e60012;
      --red-dark: #b8000e;
      --black: #151515;
      --ink: #202020;
      --muted: #696969;
      --line: #dddddd;
      --surface: #f5f5f5;
      --white: #ffffff;
      --radius: 0;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      color: var(--ink);
      background: var(--surface);
      min-height: 100vh;
    }

    /* Header */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 5%;
      color: var(--white);
      background: var(--black);
      border-bottom: 4px solid var(--red);
    }
    .brand {
      font-family: "Arial Black", "Impact", sans-serif;
      font-size: 22px;
      color: var(--white);
      text-decoration: none;
      letter-spacing: 1px;
    }
    .brand span { color: var(--red); }
    .header-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    /* Tabs */
    .tabs {
      display: flex;
      gap: 0;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      padding: 0 5%;
    }
    .tab {
      padding: 14px 24px;
      font-weight: 700;
      font-size: 14px;
      text-transform: uppercase;
      cursor: pointer;
      border: none;
      background: none;
      color: var(--muted);
      border-bottom: 3px solid transparent;
      transition: all 0.15s;
    }
    .tab.active {
      color: var(--red);
      border-bottom-color: var(--red);
    }
    .tab:hover { color: var(--ink); }

    /* Main */
    main {
      max-width: 1300px;
      margin: 0 auto;
      padding: 24px 5% 60px;
    }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* Panel */
    .panel {
      background: var(--white);
      border: 1px solid var(--line);
      margin-bottom: 20px;
    }
    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 16px 20px;
      border-bottom: 1px solid var(--line);
      background: #fafafa;
    }
    .panel-head h2 {
      font-family: "Arial Black", "Impact", sans-serif;
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .panel-body { padding: 20px; }

    /* Forms */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .form-grid .span-2 { grid-column: 1 / -1; }

    label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-weight: 600;
      font-size: 13px;
      color: var(--ink);
    }
    label .hint {
      font-weight: 400;
      font-size: 11px;
      color: var(--muted);
    }

    input, select, textarea {
      width: 100%;
      min-height: 42px;
      padding: 10px 12px;
      border: 1px solid var(--line);
      font: inherit;
      font-size: 14px;
      background: var(--white);
      transition: border-color 0.15s;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--red);
      box-shadow: 0 0 0 2px rgba(230,0,18,0.1);
    }
    textarea {
      min-height: 90px;
      resize: vertical;
      line-height: 1.5;
    }

    /* Buttons */
    button, .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 40px;
      padding: 0 18px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border: 1px solid var(--red);
      background: var(--red);
      color: var(--white);
      cursor: pointer;
      transition: background 0.15s, opacity 0.15s;
    }
    button:hover { background: var(--red-dark); }
    button:disabled { opacity: 0.5; cursor: not-allowed; }

    button.secondary {
      background: var(--white);
      color: var(--ink);
      border-color: var(--line);
    }
    button.secondary:hover { background: #f0f0f0; }

    button.danger {
      background: #8f101b;
      border-color: #8f101b;
    }
    button.danger:hover { background: #6a0c14; }

    button.small {
      min-height: 32px;
      padding: 0 12px;
      font-size: 11px;
    }

    button.icon-btn {
      min-height: 32px;
      width: 32px;
      padding: 0;
      border-radius: 50%;
      font-size: 16px;
    }

    .toolbar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    .message {
      font-size: 13px;
      font-weight: 600;
      min-height: 20px;
      color: var(--muted);
    }
    .message.success { color: #2e7d32; }
    .message.error { color: var(--red); }

    /* Tables */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    th, td {
      padding: 10px 12px;
      text-align: left;
      vertical-align: middle;
      border-bottom: 1px solid var(--line);
    }
    th {
      font-weight: 700;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: #fafafa;
      color: var(--muted);
    }
    tr:hover td { background: #fafafa; }
    .thumbs { display: flex; gap: 4px; }
    .thumb {
      width: 48px;
      height: 36px;
      object-fit: cover;
      background: #eee;
      border: 1px solid var(--line);
    }
    .muted { color: var(--muted); }
    .hidden { display: none !important; }

    /* Product form - Modal */
    #productFormWrap {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      z-index: 9999;
      padding: 30px 16px;
      overflow-y: auto;
    }
    #productFormWrap.visible { display: block; }
    #productFormWrap > #productFormInner {
      max-width: 900px;
      margin: 0 auto;
      background: #fffafa;
      border: 2px solid var(--red);
      padding: 20px;
      border-radius: 4px;
      position: relative;
    }
    #productFormCloseBtn {
      position: absolute;
      top: 10px; right: 14px;
      font-size: 24px;
      background: none;
      border: none;
      cursor: pointer;
      color: #888;
      line-height: 1;
    }
    #productFormCloseBtn:hover { color: var(--red); }
    #productFormWrap h3 {
      font-family: "Arial Black", "Impact", sans-serif;
      font-size: 15px;
      text-transform: uppercase;
      margin-bottom: 16px;
      color: var(--red);
    }

    /* Image upload area */
    .upload-section {
      border: 2px dashed var(--line);
      padding: 20px;
      text-align: center;
      background: #fafafa;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .upload-section:hover, .upload-section.drag-over {
      border-color: var(--red);
      background: #fff5f5;
    }
    .upload-section p { font-size: 13px; color: var(--muted); }
    .upload-section p strong { color: var(--red); }

    .image-previews {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
      margin-top: 16px;
    }
    .image-preview {
      position: relative;
      border: 1px solid var(--line);
      background: #fafafa;
      aspect-ratio: 4/3;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .image-preview img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    .image-preview .remove-img {
      position: absolute;
      top: 0;
      right: 0;
      width: 28px;
      height: 28px;
      background: var(--red);
      color: #fff;
      border: none;
      font-size: 16px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      padding: 0;
      min-height: 28px;
    }
    .image-preview .img-label {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 4px 8px;
      font-size: 11px;
      font-weight: 600;
      background: rgba(0,0,0,0.7);
      color: #fff;
      text-align: center;
    }

    /* Category inline manager */
    .cat-inline {
      display: flex;
      gap: 8px;
      align-items: flex-end;
      flex-wrap: wrap;
    }
    .cat-inline select { flex: 1; min-width: 200px; }

    .cat-manager {
      margin-top: 12px;
      padding: 14px;
      background: #fafafa;
      border: 1px solid var(--line);
      display: none;
    }
    .cat-manager.open { display: block; }
    .cat-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }
    .cat-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 600;
      background: var(--white);
      border: 1px solid var(--line);
    }
    .cat-tag .cat-del {
      cursor: pointer;
      color: var(--red);
      font-weight: 700;
      font-size: 14px;
      line-height: 1;
    }
    .cat-tag .cat-del:hover { color: #6a0c14; }

    /* Login */
    .login-box {
      max-width: 420px;
      margin: 60px auto;
    }

    /* Save bar */
    .save-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 20px;
      background: var(--black);
      color: var(--white);
      margin-top: 16px;
    }
    .save-bar .msg { font-size: 13px; font-weight: 600; }

    /* Inline add form */
    .inline-add {
      display: none;
      margin-top: 6px;
      gap: 4px;
      align-items: center;
    }
    .inline-add.visible { display: flex; }
    .inline-add input {
      flex: 1;
      min-height: 32px;
      font-size: 12px;
    }

    /* Fitment tags */
    .fitment-row {
      display: flex;
      gap: 8px;
      align-items: flex-end;
      flex-wrap: wrap;
    }
    .fitment-row select { flex: 1; min-width: 130px; }

    .fitment-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;
    }
    .fitment-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 600;
      background: #e8f5e9;
      border: 1px solid #a5d6a7;
      color: #2e7d32;
    }
    .fitment-tag .fitment-del {
      cursor: pointer;
      color: var(--red);
      font-weight: 700;
      font-size: 14px;
      line-height: 1;
    }

    @media (max-width: 768px) {
      .form-grid { grid-template-columns: 1fr; }
      .image-previews { grid-template-columns: 1fr 1fr; }
      .fitment-row { flex-direction: column; }
      table, thead, tbody, tr, th, td { display: block; }
      thead { display: none; }
      tr { border-bottom: 2px solid var(--line); margin-bottom: 8px; }
      td { border: 0; padding: 6px 12px; }
      td::before {
        content: attr(data-label);
        display: block;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 2px;
      }
    }

  /* ZAG Security: default-lock all admin areas */
  #adminTabs, #tab-products, #productFormWrap, #tab-categories {
    display: none !important;
  }
  /* Only unlock when auth-passed */
  body.auth-passed #adminTabs {
    display: block !important;
  }
  body.auth-passed .tab-panel.active {
    display: block !important;
  }
  /* Modal must ALSO have .visible class to show - not just auth-passed */
  body.auth-passed #productFormWrap.visible {
    display: block !important;
  }
  </style>
</head>
<body>

<header>
  <a href="/" class="brand">ZAG <span>BRAKES</span> Admin</a>
  <div class="header-actions">
    <a class="btn secondary" href="/" target="_blank" rel="noreferrer" style="min-height:36px;font-size:11px;">View Site</a>
    <button class="secondary small hidden" id="logoutBtn" type="button">Logout</button>
  </div>
</header>

<nav class="tabs hidden" id="adminTabs">
  <button class="tab active" data-tab="products">Products</button>
  <button class="tab" data-tab="categories">Categories</button>
  <button class="tab" data-tab="import">Import</button>
</nav>

<main>

  <!-- Login -->
  <section class="panel login-box" id="loginPanel">
    <div class="panel-head"><h2>Admin Login</h2></div>
    <form class="panel-body form-grid" id="loginForm">
      <label class="span-2">
        Username
        <input type="text" name="username" value="admin" autocomplete="username" required>
      </label>
      <label class="span-2">
        Password
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <div class="span-2 toolbar">
        <button type="submit">Login</button>
        <span class="message" id="loginMessage"></span>
      </div>
    </form>
  </section>

  <!-- ========== PRODUCTS TAB ========== -->
  <section class="tab-panel active" id="tab-products">
    <div class="panel">
      <div class="panel-head">
        <h2>Products</h2>
        <div class="toolbar">
          <span class="message" id="productMessage"></span>
          <button id="addProductBtn" type="button">+ Add Product</button>
        </div>
      </div>
      <div class="panel-body">

        <!-- Product Form -->
        <div id="productFormWrap">
          <div id="productFormInner">
          <button type="button" id="productFormCloseBtn" title="Close">&times;</button>
          <h3 id="productFormTitle">Add Product</h3>
          <form id="productForm" class="form-grid" enctype="multipart/form-data">
            <input type="hidden" name="id">
            <input type="hidden" name="fitments" id="fitmentsInput" value="[]">

            <label>
              Part Number <span class="hint">(SKU)</span>
              <input name="sku" placeholder="e.g. ZAG-PAD-F001">
            </label>

            <label>
              Product Name <span class="hint">*</span>
              <input name="name" placeholder="e.g. Sintered Front Brake Pad" required>
            </label>

            <!-- Vehicle Fitment Section -->
            <div class="span-2" style="border:1px solid var(--line);padding:16px;background:#fafafa;">
              <strong style="font-size:13px;text-transform:uppercase;">Vehicle Fitment</strong>
              <span class="hint" style="display:block;margin:4px 0 10px;">Select Make > Model > Year > Engine > Position, then click Add Fitment</span>

              <div class="fitment-row">
                <label style="flex:2;">
                  Make
                  <div style="display:flex;gap:4px;">
                    <select id="productMakeSelect" style="flex:1;"><option value="">-- Select Make --</option></select>
                    <button type="button" class="secondary small" id="addMakeBtn" title="Add Make">+</button>
                  </div>
                </label>
                <div class="inline-add" id="addMakeForm">
                  <input id="newMakeName" placeholder="e.g. Honda" style="flex:1;min-height:32px;font-size:12px;">
                  <button type="button" class="small" id="saveNewMakeBtn">Save</button>
                  <button type="button" class="secondary small" id="cancelNewMakeBtn">X</button>
                </div>

                <label style="flex:2;">
                  Model
                  <div style="display:flex;gap:4px;">
                    <select id="productModelSelect" style="flex:1;"><option value="">-- Select Model --</option></select>
                    <button type="button" class="secondary small" id="addModelBtn" title="Add Model">+</button>
                  </div>
                </label>
                <div class="inline-add" id="addModelForm">
                  <input id="newModelName" placeholder="e.g. CBR600RR" style="flex:1;min-height:32px;font-size:12px;">
                  <button type="button" class="small" id="saveNewModelBtn">Save</button>
                  <button type="button" class="secondary small" id="cancelNewModelBtn">X</button>
                </div>

                <label style="flex:1;">
                  Year
                  <select id="productYearSelect"><option value="">-- Year --</option></select>
                </label>

                <label style="flex:1;">
                  Engine
                  <select id="productEngineSelect"><option value="">-- Engine --</option></select>
                </label>

                <label style="flex:1;">
                  Position
                  <select id="productPositionSelect">
                    <option value="Front">Front</option>
                    <option value="Rear">Rear</option>
                  </select>
                </label>

                <button type="button" class="small" id="addFitmentBtn" style="align-self:flex-end;margin-bottom:2px;">+ Add</button>
              </div>

              <div class="fitment-tags" id="fitmentTags"></div>
            </div>

            <label>
              EBC Number <span class="hint">(Cross-reference)</span>
              <input name="ebcNumber" placeholder="e.g. FA123">
            </label>

            <label>
              Material <span class="hint">Sintered / Semi-metallic / Ceramic / Organic</span>
              <input name="material" placeholder="e.g. Sintered">
            </label>

            <div class="span-2">
              <div style="display:flex;flex-direction:column;gap:6px;">
                <label style="margin:0;">Category <span class="hint">*</span></label>
                <div class="cat-inline">
                  <select name="categoryId" required></select>
                  <button type="button" class="secondary small" id="toggleCatManager">Manage</button>
                </div>
                <div class="cat-manager" id="catManager">
                  <div class="form-grid" style="margin-bottom:10px;">
                    <label>Name <input id="catNameInput" placeholder="e.g. Brake Pads"></label>
                    <label>Slug <input id="catSlugInput" placeholder="auto-generated"></label>
                  </div>
                  <div class="toolbar">
                    <button type="button" class="small" id="addCatBtn">+ Add</button>
                    <button type="button" class="small secondary" id="closeCatManager">Close</button>
                  </div>
                  <div class="cat-list" id="catTagsList"></div>
                </div>
              </div>
            </div>

            <label>
              Status
              <select name="status">
                <option value="published">Published</option>
                <option value="draft">Draft</option>
              </select>
            </label>

            <label>
              Sort Order
              <input name="sortOrder" type="number" value="100">
            </label>

            <!-- Image Upload -->
            <div class="span-2">
              <label>Product Images <span class="hint">(up to 3 - click or drag to upload)</span></label>
              <div class="upload-section" id="uploadZone">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <p><strong>Click to browse</strong> or drag images here</p>
                <p style="font-size:11px;">JPG, PNG, WebP - up to 5 MB each</p>
              </div>
              <input type="file" id="imageInput" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden>
              <div class="image-previews" id="imagePreviews"></div>
            </div>

            <label class="span-2">
              Description
              <textarea name="description" placeholder="Product description, specifications, and notes"></textarea>
            </label>

            <label class="span-2">
              Features <span class="hint">(one per line)</span>
              <textarea name="features" placeholder="Low noise formula&#10;High heat resistance&#10;Stable friction coefficient"></textarea>
            </label>

            <div class="span-2">
              <div class="save-bar">
                <span class="msg" id="saveMsg">Ready</span>
                <div class="toolbar">
                  <button type="button" class="secondary" id="cancelProductBtn">Cancel</button>
                  <button type="submit">Save Product</button>
                </div>
              </div>
            </div>
          </form>
          </div>
        </div>

        <!-- Product Table -->
        <table>
          <thead><tr><th>Image</th><th>Part #</th><th>Name</th><th>Fitment</th><th>EBC #</th><th>Category</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody id="productRows"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========== CATEGORIES TAB ========== -->
  <section class="tab-panel" id="tab-categories">
    <div class="panel">
      <div class="panel-head">
        <h2>Category Manager</h2>
        <span class="message" id="categoryMessage"></span>
      </div>
      <div class="panel-body">
        <form id="categoryForm" class="form-grid">
          <input type="hidden" name="id">
          <label>
            Category Name
            <input name="name" placeholder="e.g. Brake Pads" required>
          </label>
          <label>
            URL Slug
            <input name="slug" placeholder="e.g. brake-pads">
          </label>
          <label>
            Sort Order
            <input name="sortOrder" type="number" value="100">
          </label>
          <label class="span-2">
            Description
            <textarea name="description" placeholder="Short description"></textarea>
          </label>
          <div class="span-2 toolbar">
            <button type="submit">Save Category</button>
            <button type="button" class="secondary" id="resetCategoryBtn">Clear</button>
          </div>
        </form>

        <table style="margin-top:16px;">
          <thead><tr><th>Name</th><th>Slug</th><th>Product Count</th><th>Actions</th></tr></thead>
          <tbody id="categoryRows"></tbody>
        </table>
      </div>
    </div>
  </section>

</main>

<script>
(function () {
  var tokenKey = "zagAdminToken";

  // ===== DOM refs =====
  var loginPanel = document.getElementById("loginPanel");
  var adminTabs = document.getElementById("adminTabs");
  var logoutBtn = document.getElementById("logoutBtn");

  // Product tab
  var productForm = document.getElementById("productForm");
  var productFormWrap = document.getElementById("productFormWrap");
  var productFormTitle = document.getElementById("productFormTitle");
  var productRows = document.getElementById("productRows");
  var categorySelect = productForm.querySelector("[name=categoryId]");
  var productMessage = document.getElementById("productMessage");

  // Image upload
  var uploadZone = document.getElementById("uploadZone");
  var imageInput = document.getElementById("imageInput");
  var imagePreviews = document.getElementById("imagePreviews");
  var pendingImages = [];
  var existingImages = [];
  var removedExisting = [];

  // Category manager
  var catManager = document.getElementById("catManager");
  var catTagsList = document.getElementById("catTagsList");
  var catNameInput = document.getElementById("catNameInput");
  var catSlugInput = document.getElementById("catSlugInput");

  // Category tab
  var categoryForm = document.getElementById("categoryForm");
  var categoryRows = document.getElementById("categoryRows");

  // Vehicle fitment
  var fitmentsInput = document.getElementById("fitmentsInput");
  var fitmentTags = document.getElementById("fitmentTags");
  var pendingFitments = [];

  // ===== State =====
  var catalog = { categories: [], products: [] };
  var allMakes = [];
  var allModels = [];
  var MAX_IMAGES = 3;

  // ===== Helpers =====
  function token() { return localStorage.getItem(tokenKey); }
  function esc(v) {
    return String(v || "").replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
    });
  }
  function msg(el, text, cls) {
    el.textContent = text;
    el.className = "message " + (cls || "");
    if (text) setTimeout(function () { el.textContent = ""; el.className = "message"; }, 4000);
  }

  async function api(path, options) {
    options = options || {};
    var headers = options.headers || {};
    var bodyIsForm = options.body instanceof FormData;
    if (!bodyIsForm && options.body) headers["Content-Type"] = "application/json";
    if (token()) headers.Authorization = "Bearer " + token();
    var resp = await fetch(path, { method: options.method || "GET", headers: headers, body: options.body });
    var data = await resp.json();
    if (!resp.ok) throw new Error(data.error || "Request failed");
    return data;
  }

