<!DOCTYPE html>
<html lang="en">
<head>
<script>if (window.location.protocol === "file:") { window.location.href = "http://localhost:3000"; }</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZAG BRAKES | Professional Brake Components Manufacturer</title>
  <style>
    :root {
      --zag-red: #E60012;
      --zag-black: #1A1A1A;
      --zag-white: #FFFFFF;
      --zag-gray: #f5f5f5;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Arial Black', Gadget, sans-serif;
      margin: 0; padding: 0;
      background-color: var(--zag-white);
      color: var(--zag-black);
      scroll-behavior: smooth;
    }

    header {
      background-color: var(--zag-black);
      color: white;
      padding: 10px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 5px solid var(--zag-red);
      position: sticky; top: 0; z-index: 1000;
    }

    .logo-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      border: 2px solid white;
      padding: 5px 15px;
    }

    .logo-text { font-size: 28px; font-weight: 900; text-decoration: none; color: white; line-height: 1; }
    .logo-text span { color: var(--zag-red); }
    .header-slogan { font-size: 9px; color: #ccc; letter-spacing: 1.5px; font-family: Arial, sans-serif; margin-top: 4px; text-transform: uppercase; }

    nav { display: flex; gap: 20px; font-size: 13px; align-items: center; }
    nav a { color: white; text-decoration: none; cursor: pointer; transition: 0.3s; font-family: 'Arial Black'; }
    nav a:hover { color: var(--zag-red); }

    .dropdown { position: relative; }
    .dropdown-content {
      display: none; position: absolute; background-color: #f9f9f9;
      min-width: 180px; box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
      top: 25px; z-index: 100;
    }
    .dropdown-content a {
      color: black !important; padding: 12px 16px; display: block;
      font-family: 'Arial Black', sans-serif !important;
      font-size: 13px; font-weight: 900; text-transform: uppercase;
      border-bottom: 1px solid #eee;
    }
    .dropdown-content a:hover { background-color: #eee; border-left: 5px solid var(--zag-red); }
    .dropdown:hover .dropdown-content { display: block; }

    .lang-btn { background: #333; border: 1px solid #555; color: white; padding: 5px 10px; cursor: pointer; font-size: 12px; }

    /* Hero */
    .hero {
      position: relative; background-color: var(--zag-black); color: white;
      padding: 100px 5% 150px; overflow: hidden;
    }
    .hero::after {
      content: ""; position: absolute; bottom: 0; right: 0; width: 100%; height: 100%;
      background: var(--zag-red); clip-path: polygon(100% 20%, 100% 100%, 0% 100%);
      z-index: 1; opacity: 0.9;
    }
    .hero-content { position: relative; z-index: 2; }
    .hero h2 { font-size: 55px; margin: 0; line-height: 1; text-transform: uppercase; }
    .hero p.sub-text { color: var(--zag-red); font-size: 18px; margin-bottom: 10px; letter-spacing: 2px; }

    .section-title { border-left: 10px solid var(--zag-red); padding-left: 15px; font-size: 32px; font-family: 'Arial Black'; margin-bottom: 30px; text-transform: uppercase; }

    .about-section { padding: 80px 5%; background: #fdfdfd; line-height: 1.6; }
    .about-container { max-width: 1000px; margin: 0 auto; font-family: Arial, sans-serif; }

    .product-section { padding: 60px 5%; background: white; }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }

    .card {
      border: 1px solid #ddd;
      transition: 0.3s;
      display: flex;
      flex-direction: column;
    }
    .card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.1); }

    .card-images {
      height: 220px;
      background: #f5f5f5;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-images img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      transition: opacity 0.4s;
    }

    .card-images img.active { opacity: 1; z-index: 1; }
    .card-images img.inactive { opacity: 0; z-index: 0; }

    .card-images .no-img {
      color: #bbb;
      font-family: Arial, sans-serif;
      font-size: 14px;
    }

    .card-dots {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      z-index: 5;
    }

    .card-dots .dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.5);
      border: 1px solid #999;
      cursor: pointer;
    }
    .card-dots .dot.active { background: var(--zag-red); border-color: var(--zag-red); }

    .card-header {
      background-color: var(--zag-black);
      color: white;
      padding: 15px;
      text-align: center;
      font-size: 18px;
      text-transform: uppercase;
    }

    .card-body {
      padding: 20px;
      text-align: center;
      font-family: Arial, sans-serif;
      flex: 1;
    }

    .card-body p { margin: 4px 0; }
    .card-body .material { color: #666; font-size: 13px; }
    .card-body .features { color: var(--zag-red); font-weight: bold; font-size: 13px; margin-top: 8px; }


    .category-card { cursor: pointer; border: 2px solid #ddd; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
    .category-card:hover { border-color: var(--zag-red); box-shadow: 0 6px 25px rgba(230,0,18,0.15); transform: translateY(-4px); }
    .category-card .card-body { display: flex; flex-direction: column; justify-content: center; min-height: 120px; }
    .category-card .card-body .cat-desc { color: #666; font-size: 14px; margin-top: 8px; }
    .category-card .card-body .cat-count { color: var(--zag-red); font-weight: bold; font-size: 13px; margin-top: 10px; }
    .back-btn { display: inline-block; background: var(--zag-black); color: white; padding: 10px 25px; text-decoration: none; font-size: 14px; font-family: 'Arial Black'; cursor: pointer; margin-bottom: 20px; border: none; text-transform: uppercase; transition: background 0.2s; }
    .back-btn:hover { background: var(--zag-red); }


    .category-section { margin-bottom: 40px; }
    .category-section h3 {
      font-size: 20px;
      text-transform: uppercase;
      font-family: 'Arial Black';
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 2px solid var(--zag-red);
    }

    footer { background: #000; color: #666; padding: 40px 5%; text-align: center; font-family: Arial, sans-serif; }

    .loading { text-align: center; padding: 40px; font-family: Arial, sans-serif; color: #999; }
    .empty { text-align: center; padding: 40px; font-family: Arial, sans-serif; color: #999; }

    .server-warning {
      background: #fff3cd;
      border: 2px solid #ffc107;
      padding: 20px;
      text-align: center;
      font-family: Arial, sans-serif;
      margin: 0 5% 20px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    @media (max-width: 768px) {
      header { flex-direction: column; gap: 15px; }
      .hero h2 { font-size: 34px; }
      nav { gap: 10px; font-size: 11px; }
    }

    /* Vehicle Search */
    .search-section { padding: 30px 5%; background: var(--zag-black); border-bottom: 4px solid var(--zag-red); }
    .search-box { max-width: 1200px; margin: 0 auto; display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
    .search-box label { display: flex; flex-direction: column; gap: 4px; font-size: 11px; font-family: Arial, sans-serif; color: #aaa; text-transform: uppercase; letter-spacing: 1px; flex: 1; min-width: 140px; }
    .search-box input, .search-box select { padding: 12px 14px; border: 1px solid #444; background: #222; color: #fff; font-family: Arial, sans-serif; font-size: 14px; min-height: 46px; }
    .search-box input:focus, .search-box select:focus { outline: none; border-color: var(--zag-red); }
    .search-box input::placeholder { color: #666; }
    .search-btn { padding: 0 28px; min-height: 46px; background: var(--zag-red); color: #fff; border: none; font-family: 'Arial Black', sans-serif; font-size: 13px; text-transform: uppercase; cursor: pointer; letter-spacing: 1px; white-space: nowrap; }
    .search-btn:hover { background: #c5000f; }
    .search-results { max-width: 1200px; margin: 20px auto 0; font-family: Arial, sans-serif; }
    .search-results .count { color: #aaa; font-size: 13px; margin-bottom: 16px; }
    @media (max-width: 768px) { .search-box { flex-direction: column; } .search-box label { min-width: 100%; } .search-btn { width: 100%; } }


    /* Floating WhatsApp Button */
    .whatsapp-float {
      position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px;
      background: #25D366; border-radius: 50%; box-shadow: 0 4px 15px rgba(37,211,102,0.4);
      z-index: 9999; display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: transform 0.3s, box-shadow 0.3s;
      animation: pulse-whatsapp 2s infinite;
    }
    .whatsapp-float:hover { transform: scale(1.1); box-shadow: 0 6px 20px rgba(37,211,102,0.6); }
    .whatsapp-float svg { width: 34px; height: 34px; fill: #fff; }
    @keyframes pulse-whatsapp {
      0% { box-shadow: 0 0 0 0 rgba(37,211,102,0.5); }
      70% { box-shadow: 0 0 0 15px rgba(37,211,102,0); }
      100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); }
    }
    @media (max-width: 768px) {
      .whatsapp-float { bottom: 20px; right: 20px; width: 50px; height: 50px; }
      .whatsapp-float svg { width: 28px; height: 28px; }
    }

  
.modal-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:9999;justify-content:center;align-items:center;overflow-y:auto}
.modal-overlay.active{display:flex}
.modal-content{display:flex;flex-wrap:wrap;background:white;max-width:960px;width:95%;margin:40px auto;position:relative;border:3px solid var(--zag-red);animation:modalIn .3s ease-out}
@keyframes modalIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
.modal-close{position:absolute;top:10px;right:15px;z-index:10;background:var(--zag-red);color:white;border:none;font-size:24px;width:40px;height:40px;cursor:pointer;font-weight:bold;line-height:1}
.modal-image{flex:1 1 55%;min-width:300px;background:#000;display:flex;align-items:center;justify-content:center;position:relative;min-height:400px}
.modal-image img{max-width:100%;max-height:500px;object-fit:contain}
.modal-image .nav-arrow{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,0.5);color:white;border:none;font-size:30px;cursor:pointer;padding:10px 15px;z-index:5}
.modal-image .nav-prev{left:10px}.modal-image .nav-next{right:10px}
.modal-image .img-counter{position:absolute;bottom:10px;right:15px;color:white;font-size:13px;font-family:Arial,sans-serif;background:rgba(0,0,0,0.6);padding:3px 10px;border-radius:10px}
.modal-details{flex:1 1 40%;min-width:280px;padding:30px;font-family:Arial,sans-serif;overflow-y:auto;max-height:550px}
.modal-details h3{font-family:Arial Black;font-size:20px;margin-bottom:5px}
.modal-details .sku{color:var(--zag-red);font-weight:bold;font-size:14px;margin-bottom:15px}
.modal-details .row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #eee}
.modal-details .lbl{color:#888;font-weight:bold}.modal-details .val{color:#333}
.modal-details .md{font-family:Arial;margin-top:15px;line-height:1.6;color:#555}
.pagination{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:30px;padding:20px}
.pagination button{padding:8px 16px;border:1px solid #ddd;background:white;cursor:pointer;font-family:Arial;font-size:14px;min-width:40px}
.pagination button:hover{background:#f0f0f0}
.pagination button.on{background:var(--zag-red);color:white;border-color:var(--zag-red)}
.pagination button:disabled{opacity:.4;cursor:not-allowed}
.pagination .pi{font-family:Arial;font-size:13px;color:#888;margin-left:10px}
@media(max-width:768px){.modal-content{flex-direction:column}.modal-image{min-height:250px}.modal-image img{max-height:300px}.modal-details{max-height:none}}

</style>

  <!-- SEO Meta -->
  <meta name="description" id="meta-desc" content="ZAG BRAKES - Professional manufacturer of premium brake pads, discs, and friction materials for motorcycles, ATV, and UTV. Sintered, ceramic, and semi-metallic compounds.">
