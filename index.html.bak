    pt: { desc: "ZAG BRAKES - Fabricante profissional de pastilhas de freio, discos e materiais de friccao para motocicletas, ATV e UTV.", keywords: "pastilhas de freio moto, discos de freio, freios ATV, freios UTV, pastilhas sinterizadas, pastilhas ceramicas, ZAG BRAKES", title: "ZAG BRAKES | Fabricante Profissional de Componentes de Freio" }
  };

  function updateSeoTags(lang) {
    var m = seoMeta[lang] || seoMeta.en;
    document.title = m.title;
    var descEl = document.getElementById("meta-desc");
    var kwEl = document.getElementById("meta-keywords");
    var ogtEl = document.getElementById("og-title");
    var ogdEl = document.getElementById("og-desc");
    var twtEl = document.getElementById("tw-title");
    var twdEl = document.getElementById("tw-desc");
    if (descEl) descEl.setAttribute("content", m.desc);
    if (kwEl) kwEl.setAttribute("content", m.keywords);
    if (ogtEl) ogtEl.setAttribute("content", m.title);
    if (ogdEl) ogdEl.setAttribute("content", m.desc);
    if (twtEl) twtEl.setAttribute("content", m.title);
    if (twdEl) twdEl.setAttribute("content", m.desc);
    document.documentElement.lang = lang === "cn" ? "zh" : (lang === "pt" ? "pt-BR" : lang);
  }


  function changeLang(lang) {
    currentLang = lang;
    var t = translations[lang];
    document.getElementById("current-lang").innerHTML = t.lang;
    document.getElementById("nav-products").innerHTML = t.navProducts;
    document.getElementById("nav-about").innerHTML = t.navAbout;
    document.getElementById("nav-contact").innerHTML = t.navContact;
    document.getElementById("hero-sub").innerHTML = t.heroSub;
    document.getElementById("hero-title").innerHTML = t.heroTitle;
    document.getElementById("hero-desc").innerHTML = t.heroDesc;
    document.getElementById("about-title").innerHTML = t.aboutTitle;
    document.getElementById("about-content").innerHTML = t.aboutContent;
    document.getElementById("prod-title-main").innerHTML = t.prodTitle;
    document.getElementById("contact-title").innerHTML = t.contactTitle;
    document.getElementById("btn-inquiry").innerHTML = t.btnInquiry;
    updateSeoTags(lang);
    updateSeoTags(currentLang);
  var mdlImgs=[],mdlIdx=0;
function cardClick(el){var pid=el.getAttribute("data-pid");if(pid)openModal(pid)}
function openModal(pid){
 var o=document.getElementById("productModal");o.classList.add("active");
 document.getElementById("modalMainImg").src="";
 document.getElementById("modalDetails").innerHTML='<div class="loading">Loading...</div>';
 document.getElementById("modalPrev").style.display="none";
 document.getElementById("modalNext").style.display="none";
 document.body.style.overflow="hidden";
 fetch("/api/products/"+pid).then(function(r){return r.json()}).then(function(p){
  mdlImgs=p.images||[];mdlIdx=0;updMdlImg();
  if(mdlImgs.length>1){document.getElementById("modalPrev").style.display="block";document.getElementById("modalNext").style.display="block"}
  var h="<h3>"+esc(p.name)+"</h3>";
  if(p.sku)h+='<div class="sku">'+esc(p.sku)+'</div>';
  if(p.brand)h+='<div class="row"><span class="lbl">Brand</span><span class="val">'+esc(p.brand)+'</span></div>';
  if(p.material)h+='<div class="row"><span class="lbl">Material</span><span class="val">'+esc(p.material)+'</span></div>';
  if(p.specifications)h+='<div class="md">'+esc(p.specifications)+'</div>';
  if(p.description)h+='<div class="md">'+esc(p.description)+'</div>';
  if(p.crossRefs&&p.crossRefs.length){h+='<div class="md"><b>Cross References:</b><br>';p.crossRefs.forEach(function(cr){h+=esc(cr.ref_type)+': '+esc(cr.ref_number)+(cr.brand?' ('+esc(cr.brand)+')':'')+'<br>'});h+='</div>'};if(p.vehicles&&p.vehicles.length){h+='<div class="md"><b>Vehicle Fitment:</b><br>';p.vehicles.forEach(function(v){h+=esc(v.make)+' '+esc(v.model)+' ('+esc(v.year)+') '+esc(v.engine)+' '+esc(v.position)+'<br>'});h+='</div>'}
  if(p.crossRefs&&p.crossRefs.length){h+='<div class="md"><b>Cross References:</b><br>';p.crossRefs.forEach(function(cr){h+=esc(cr.ref_type)+': '+esc(cr.ref_number)+(cr.brand?' ('+esc(cr.brand)+')':'')+'<br>'});h+='</div>'}
  document.getElementById("modalDetails").innerHTML=h
 }).catch(function(){document.getElementById("modalDetails").innerHTML='<div class="empty">Load failed</div>'})
}
function closeModal(){document.getElementById("productModal").classList.remove("active");document.body.style.overflow="";mdlImgs=[];mdlIdx=0}
function updMdlImg(){if(!mdlImgs.length){document.getElementById("modalMainImg").src="";return}document.getElementById("modalMainImg").src=mdlImgs[mdlIdx];document.getElementById("modalCounter").textContent=(mdlIdx+1)+"/"+mdlImgs.length}
function modalNext(){if(mdlImgs.length<=1)return;mdlIdx=(mdlIdx+1)%mdlImgs.length;updMdlImg()}
function modalPrev(){if(mdlImgs.length<=1)return;mdlIdx=(mdlIdx-1+mdlImgs.length)%mdlImgs.length;updMdlImg()}
document.addEventListener("keydown",function(e){if(e.key==="Escape")closeModal();if(e.key==="ArrowRight")modalNext();if(e.key==="ArrowLeft")modalPrev()});
function esc(v){return String(v||"").replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
var catId=null,catPage=1,catLimit=12;
function showCatPage(cid,pg){
 pg=pg||1;catId=cid;catPage=pg;
 var c=document.getElementById("products-container");
 c.innerHTML='<div class="loading">Loading...</div>';
 fetch("/api/catalog?category="+cid+"&page="+pg+"&limit="+catLimit).then(function(r){return r.json()}).then(function(d){
  var cn=d.categories.find(function(x){return x.id===cid});var nm=cn?cn.name:"Products";
  if(!d.products.length){c.innerHTML='<button class="back-btn" onclick="showAllCategories()">Back</button><div class="empty">No products</div>';document.getElementById("pg-container").innerHTML="";return}
  var h='<button class="back-btn" onclick="showAllCategories()">Back</button><h3>'+esc(nm)+'</h3><div class="grid">';
  d.products.forEach(function(p){h+=renderProductCardPC(p,nm)});h+='</div>';c.innerHTML=h;bindCardDots();
  renderPg(d.pagination,cid);c.scrollIntoView({behavior:"smooth"})
 }).catch(function(e){c.innerHTML='<div class="empty">Error: '+esc(e.message)+'</div>'})
}
function renderPg(pg,cid){
 var c=document.getElementById("pg-container");if(!pg||pg.totalPages<=1){c.innerHTML="";return}
 var h='<div class="pagination">';h+='<button '+(pg.page<=1?"disabled":"")+' onclick="showCatPage(catId,'+(pg.page-1)+')">Prev</button>';
 var s=Math.max(1,pg.page-2),e=Math.min(pg.totalPages,pg.page+2);
 if(s>1){h+='<button onclick="showCatPage(catId,1)">1</button>';if(s>2)h+='<span class="pi">...</span>'}
 for(var i=s;i<=e;i++)h+='<button class="'+(i===pg.page?"on":"")+'" onclick="showCatPage(catId,'+i+')">'+i+'</button>';
 if(e<pg.totalPages){if(e<pg.totalPages-1)h+='<span class="pi">...</span>';h+='<button onclick="showCatPage(catId,'+pg.totalPages+')">'+pg.totalPages+'</button>'}
 h+='<button '+(pg.page>=pg.totalPages?"disabled":"")+' onclick="showCatPage(catId,'+(pg.page+1)+')">Next</button>';
 h+='<span class="pi">'+pg.total+' products</span></div>';c.innerHTML=h
}
function renderProductCardPC(pr,cn){
 var imgs=pr.images||[],ih="",dh="";
 if(imgs.length){ih=imgs.map(function(s,i){return'<img class="'+(i===0?"active":"inactive")+'" src="'+esc(s)+'" alt="'+esc(pr.name)+'" loading="lazy">'}).join("")}
 else ih='<div class="no-img">No image</div>';
 if(imgs.length>1){dh='<div class="card-dots">'+imgs.map(function(_,i){return'<span class="dot '+(i===0?"active":"")+'" data-dot="'+i+'"></span>'}).join("")+'</div>'}
 return'<div class="card" data-pid="'+esc(pr.id)+'" onclick="cardClick(this)"><div class="card-images">'+ih+dh+'</div><div class="card-header">'+esc(cn||pr.name)+'</div><div class="card-body"><p><strong>'+esc(pr.name)+'</strong></p>'+(pr.sku?'<p class="material">SKU: '+esc(pr.sku)+'</p>':'')+(pr.material?'<p class="material">'+esc(pr.material)+'</p>':'')+'</div></div>'
}
var pc=document.createElement("div");pc.id="pg-container";document.getElementById("products").appendChild(pc);


  loadProducts();
  }

  function escapeHtml(value) {
    return String(value || "").replace(/[&<>"']/g, function (char) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[char];
    });
  }

  function renderProductCard(product, categoryName) {
    var images = product.images || (product.image ? [product.image] : []);
    var features = product.features || [];
    var imageHtml = "";
    var dotsHtml = "";

    if (images.length > 0) {
      imageHtml = images.map(function (src, i) {
        var cls = i === 0 ? "active" : "inactive";
        return "<img class=\"" + cls + "\" data-img=\"" + i + "\" src=\"" + escapeHtml(src) + "\" alt=\"" + escapeHtml(product.name) + "\" loading=\"lazy\">";
      }).join("");

      if (images.length > 1) {
        dotsHtml = "<div class=\"card-dots\">" +
          images.map(function (_, i) {
            var cls = i === 0 ? "active" : "";
            return "<span class=\"dot " + cls + "\" data-dot=\"" + i + "\"></span>";
          }).join("") +
          "</div>";
      }
    } else {
      imageHtml = "<div class=\"no-img\">No image</div>";
    }

    var featuresHtml = features.length
      ? "<p class=\"features\">" + escapeHtml(features.join(" | ")) + "</p>"
      : "";

    return "<div class=\"card\">" +
      "<div class=\"card-images\">" + imageHtml + dotsHtml + "</div>" +
      "<div class=\"card-header\">" + escapeHtml(categoryName || product.name) + "</div>" +
      "<div class=\"card-body\">" +
        "<p><strong>" + escapeHtml(product.name) + "</strong></p>" +
        (product.sku ? "<p class=\"material\">SKU: " + escapeHtml(product.sku) + "</p>" : "") +
        (product.material ? "<p class=\"material\">" + escapeHtml(product.material) + "</p>" : "") +
        (product.vehicleModels ? "<p class=\"material\">" + escapeHtml(product.vehicleModels) + "</p>" : "") +
        (product.description ? "<p>" + escapeHtml(product.description) + "</p>" : "") +
        featuresHtml +
      "</div>" +
    "</div>";
  }

  function renderCategoryCards(categories) {
    if (!categories || categories.length === 0) {
      return "<div class=\"empty\">" + (translations[currentLang].noProducts || "No categories yet.") + "</div>";
    }
    var descs = {
      "Brake Pads": "Advanced Sintered and Semi-Metallic formulas.",
      "Brake Discs": "High-carbon steel rotors designed for heat dissipation.",
      "Brake Shoes": "Smooth and consistent drum braking performance.",
      "Clutch Plates": "High-performance clutch components for powersports."
    };
    var features = {
      "Brake Pads": "Low Noise | High Heat Resistance",
      "Brake Discs": "Precision Engineered",
      "Brake Shoes": "Long Life",
      "Clutch Plates": "Heavy Duty | Smooth Engagement"
    };
    var html = "<div class=\"grid\">";
    categories.forEach(function (cat) {
      var desc = descs[cat.name] || "Click to explore our " + cat.name.toLowerCase() + " products.";
      var feat = features[cat.name] || "";
      html += "<div class=\"card category-card\" onclick=\"showCategoryProducts('" + escapeHtml(cat.id) + "')\">";
      html += "<div class=\"card-header\">" + escapeHtml(cat.name) + "</div>";
      html += "<div class=\"card-body\">";
      html += "<p class=\"cat-desc\">" + escapeHtml(desc) + "</p>";
      if (feat) html += "<p class=\"cat-count\">" + escapeHtml(feat) + "</p>";
      html += "</div></div>";
    });
    html += "</div>";
    return html;
  }

  function showCategoryProducts(categoryId) { showCatPage(categoryId, 1); return; 
    if (!catalogData) return;
    var cat = catalogData.categories.find(function (c) { return c.id === categoryId; });
    var catName = cat ? cat.name : "Products";
    var products = catalogData.products.filter(function (p) { return (p.categoryId || p.category_id) === categoryId; });
    var container = document.getElementById("products-container");
    if (products.length === 0) {
      container.innerHTML = "<button class=\"back-btn\" onclick=\"showAllCategories()\">&larr; " + (translations[currentLang].back || "Back") + "</button>" +
        "<div class=\"empty\">" + (translations[currentLang].noProducts || "No products in this category.") + "</div>";
      return;
    }
    var html = "<button class=\"back-btn\" onclick=\"showAllCategories()\">&larr; " + (translations[currentLang].back || "Back") + "</button>";
    html += "<div class=\"category-section\">";
    html += "<h3 id=\"cat-" + escapeHtml(cat ? cat.slug || cat.id : categoryId) + "\">" + escapeHtml(catName) + "</h3>";
    html += "<div class=\"grid\">";
    html += products.map(function (p) { return renderProductCard(p, catName); }).join("");
    html += "</div></div>";
    container.innerHTML = html;
    bindCardDots();
    container.scrollIntoView({ behavior: "smooth" });
  }

  function showAllCategories() {
    if (!catalogData) return;
    var container = document.getElementById("products-container");
    container.innerHTML = renderCategoryCards(catalogData.categories);
    container.scrollIntoView({ behavior: "smooth" });
  }

  function bindCardDots() {
    document.querySelectorAll(".card-dots .dot").forEach(function (dot) {
      dot.addEventListener("click", function () {
        var cardImages = dot.closest(".card-images");
        var idx = dot.dataset.dot;
        var imgs = cardImages.querySelectorAll("img");
        var dots = cardImages.querySelectorAll(".dot");
        imgs.forEach(function (img) {
          img.className = img.dataset.img === idx ? "active" : "inactive";
        });
        dots.forEach(function (d) {
          d.className = d.dataset.dot === idx ? "dot active" : "dot";
        });
      });
    });
  }

  function populateNavDropdown(categories) {
    var dropdown = document.getElementById("nav-dropdown");
    dropdown.innerHTML = categories.map(function (c) {
      return "<a href=\"#cat-" + escapeHtml(c.slug || c.id) + "\">" + escapeHtml(c.name) + "</a>";
    }).join("");
  }

  // ===== Vehicle Search ===== 
  async function loadSearchMakes() {
    try {
      var resp = await fetch("/api/vehicles/makes");
      var makes = await resp.json();
      var sel = document.getElementById("searchMakeSelect");
      makes.forEach(function (m) {
        sel.innerHTML += '<option value="' + escapeHtml(m.id) + '">' + escapeHtml(m.name) + '</option>';
      });
    } catch (_) {}
  }

  document.getElementById("searchMakeSelect").addEventListener("change", async function () {
    var makeId = this.value;
    var modelSel = document.getElementById("searchModelSelect");
    var yearSel = document.getElementById("searchYearSelect");
    modelSel.innerHTML = '<option value="">All Models</option>';
    yearSel.innerHTML = '<option value="">All Years</option>';
    if (!makeId) return;
    try {
      var resp = await fetch("/api/vehicles/models?makeId=" + makeId);
      var models = await resp.json();
      models.forEach(function (m) {
        modelSel.innerHTML += '<option value="' + escapeHtml(m.id) + '">' + escapeHtml(m.name) + '</option>';
      });
    } catch (_) {}
  });

  document.getElementById("searchModelSelect").addEventListener("change", async function () {
    var modelId = this.value;
    var yearSel = document.getElementById("searchYearSelect");
    yearSel.innerHTML = '<option value="">All Years</option>';
    if (!modelId) return;
    try {
      var resp = await fetch("/api/vehicles/years?modelId=" + modelId);
      var years = await resp.json();
      years.forEach(function (y) {
        yearSel.innerHTML += '<option value="' + escapeHtml(y.id) + '">' + y.year + '</option>';
      });
    } catch (_) {}
  });

  document.getElementById("searchBtn").addEventListener("click", async function () {
    var partInput = document.getElementById("searchPartInput").value.trim();
    var makeId = document.getElementById("searchMakeSelect").value;
    var modelId = document.getElementById("searchModelSelect").value;
    var yearId = document.getElementById("searchYearSelect").value;
    var resultsDiv = document.getElementById("searchResults");

    // Priority: part number/EBC search
    if (partInput) {
      resultsDiv.innerHTML = '<div class="loading">Searching...</div>';
      try {
        var resp = await fetch("/api/search?q=" + encodeURIComponent(partInput));
        var results = await resp.json();
        if (results.length === 0) {
          resultsDiv.innerHTML = '<div class="empty">No products found for "' + escapeHtml(partInput) + '"</div>';
          return;
        }
        resultsDiv.innerHTML = '<div class="count">' + results.length + ' result(s) for "' + escapeHtml(partInput) + '"</div>' +
          '<div class="grid">' + results.map(function (r) { return renderProductCard(r.product, r.matchType); }).join("") + '</div>';
        bindCardDots();
      } catch (err) { resultsDiv.innerHTML = '<div class="empty">Search error: ' + escapeHtml(err.message) + '</div>'; }
      return;
    }

    // Vehicle search
    if (!makeId && !modelId && !yearId) {
      resultsDiv.innerHTML = '<div class="empty">Enter a part number or select a vehicle to search</div>';
      return;
    }

    resultsDiv.innerHTML = '<div class="loading">Searching...</div>';
    try {
      var params = [];
      if (makeId) params.push("makeId=" + makeId);
      if (modelId) params.push("modelId=" + modelId);
      if (yearId) params.push("yearId=" + yearId);
      var vResp = await fetch("/api/vehicles/search?" + params.join("&"));
      var products = await vResp.json();
      if (products.length === 0) {
        resultsDiv.innerHTML = '<div class="empty">No products found for this vehicle</div>';
        return;
      }
      resultsDiv.innerHTML = '<div class="count">' + products.length + ' compatible product(s)</div>' +
        '<div class="grid">' + products.map(function (p) { return renderProductCard(p, "Compatible"); }).join("") + '</div>';
      bindCardDots();
    } catch (err) { resultsDiv.innerHTML = '<div class="empty">Search error: ' + escapeHtml(err.message) + '</div>'; }
  });

  // Load makes on page load
  loadSearchMakes();

  var catalogData = null;

  async function loadProducts() {
    var container = document.getElementById("products-container");
    container.innerHTML = "<div class=\"loading\">" + (translations[currentLang].loading || "Loading...") + "</div>";

    try {
      var resp = await fetch("/api/catalog?status=published");
      if (!resp.ok) throw new Error("Server returned " + resp.status);
      var data = await resp.json();
      populateNavDropdown(data.categories || []);
      if (!data.products || data.products.length === 0) {
        container.innerHTML = "<div class=\"empty\">" + (translations[currentLang].noProducts || "No products yet.") + "</div>";
        return;
      }
      catalogData = data;
      container.innerHTML = renderCategoryCards(data.categories);
      bindCardDots();
    } catch (err) {
      if (window.location.protocol === "file:") {
        container.innerHTML = "<div class=\"server-warning\"><strong>This page must be opened through the server.</strong><br><br>Please visit <a href=\"http://localhost:3000\" style=\"color:var(--zag-red);\">http://localhost:3000</a> instead of opening the file directly.</div>";
      } else {
        container.innerHTML = "<div class=\"empty\">Could not load products.<br><small>" + escapeHtml(err.message) + "</small></div>";
      }
    }
  }

  var mdlImgs=[],mdlIdx=0;
function cardClick(el){var pid=el.getAttribute("data-pid");if(pid)openModal(pid)}
function openModal(pid){
 var o=document.getElementById("productModal");o.classList.add("active");
 document.getElementById("modalMainImg").src="";
 document.getElementById("modalDetails").innerHTML='<div class="loading">Loading...</div>';
 document.getElementById("modalPrev").style.display="none";
 document.getElementById("modalNext").style.display="none";
 document.body.style.overflow="hidden";
 fetch("/api/products/"+pid).then(function(r){return r.json()}).then(function(p){
  mdlImgs=p.images||[];mdlIdx=0;updMdlImg();
  if(mdlImgs.length>1){document.getElementById("modalPrev").style.display="block";document.getElementById("modalNext").style.display="block"}
  var h="<h3>"+esc(p.name)+"</h3>";
  if(p.sku)h+='<div class="sku">'+esc(p.sku)+'</div>';
  if(p.brand)h+='<div class="row"><span class="lbl">Brand</span><span class="val">'+esc(p.brand)+'</span></div>';
  if(p.material)h+='<div class="row"><span class="lbl">Material</span><span class="val">'+esc(p.material)+'</span></div>';
  if(p.specifications)h+='<div class="md">'+esc(p.specifications)+'</div>';
  if(p.description)h+='<div class="md">'+esc(p.description)+'</div>';
  if(p.crossRefs&&p.crossRefs.length){h+='<div class="md"><b>Cross References:</b><br>';p.crossRefs.forEach(function(cr){h+=esc(cr.ref_type)+': '+esc(cr.ref_number)+(cr.brand?' ('+esc(cr.brand)+')':'')+'<br>'});h+='</div>'};if(p.vehicles&&p.vehicles.length){h+='<div class="md"><b>Vehicle Fitment:</b><br>';p.vehicles.forEach(function(v){h+=esc(v.make)+' '+esc(v.model)+' ('+esc(v.year)+') '+esc(v.engine)+' '+esc(v.position)+'<br>'});h+='</div>'}
  if(p.crossRefs&&p.crossRefs.length){h+='<div class="md"><b>Cross References:</b><br>';p.crossRefs.forEach(function(cr){h+=esc(cr.ref_type)+': '+esc(cr.ref_number)+(cr.brand?' ('+esc(cr.brand)+')':'')+'<br>'});h+='</div>'}
  document.getElementById("modalDetails").innerHTML=h
 }).catch(function(){document.getElementById("modalDetails").innerHTML='<div class="empty">Load failed</div>'})
}
function closeModal(){document.getElementById("productModal").classList.remove("active");document.body.style.overflow="";mdlImgs=[];mdlIdx=0}
function updMdlImg(){if(!mdlImgs.length){document.getElementById("modalMainImg").src="";return}document.getElementById("modalMainImg").src=mdlImgs[mdlIdx];document.getElementById("modalCounter").textContent=(mdlIdx+1)+"/"+mdlImgs.length}
function modalNext(){if(mdlImgs.length<=1)return;mdlIdx=(mdlIdx+1)%mdlImgs.length;updMdlImg()}
function modalPrev(){if(mdlImgs.length<=1)return;mdlIdx=(mdlIdx-1+mdlImgs.length)%mdlImgs.length;updMdlImg()}
document.addEventListener("keydown",function(e){if(e.key==="Escape")closeModal();if(e.key==="ArrowRight")modalNext();if(e.key==="ArrowLeft")modalPrev()});
function esc(v){return String(v||"").replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
var catId=null,catPage=1,catLimit=12;
function showCatPage(cid,pg){
 pg=pg||1;catId=cid;catPage=pg;
 var c=document.getElementById("products-container");
 c.innerHTML='<div class="loading">Loading...</div>';
 fetch("/api/catalog?category="+cid+"&page="+pg+"&limit="+catLimit).then(function(r){return r.json()}).then(function(d){
  var cn=d.categories.find(function(x){return x.id===cid});var nm=cn?cn.name:"Products";
  if(!d.products.length){c.innerHTML='<button class="back-btn" onclick="showAllCategories()">Back</button><div class="empty">No products</div>';document.getElementById("pg-container").innerHTML="";return}
  var h='<button class="back-btn" onclick="showAllCategories()">Back</button><h3>'+esc(nm)+'</h3><div class="grid">';
  d.products.forEach(function(p){h+=renderProductCardPC(p,nm)});h+='</div>';c.innerHTML=h;bindCardDots();
  renderPg(d.pagination,cid);c.scrollIntoView({behavior:"smooth"})
 }).catch(function(e){c.innerHTML='<div class="empty">Error: '+esc(e.message)+'</div>'})
}
function renderPg(pg,cid){
 var c=document.getElementById("pg-container");if(!pg||pg.totalPages<=1){c.innerHTML="";return}
 var h='<div class="pagination">';h+='<button '+(pg.page<=1?"disabled":"")+' onclick="showCatPage(catId,'+(pg.page-1)+')">Prev</button>';
 var s=Math.max(1,pg.page-2),e=Math.min(pg.totalPages,pg.page+2);
 if(s>1){h+='<button onclick="showCatPage(catId,1)">1</button>';if(s>2)h+='<span class="pi">...</span>'}
 for(var i=s;i<=e;i++)h+='<button class="'+(i===pg.page?"on":"")+'" onclick="showCatPage(catId,'+i+')">'+i+'</button>';
 if(e<pg.totalPages){if(e<pg.totalPages-1)h+='<span class="pi">...</span>';h+='<button onclick="showCatPage(catId,'+pg.totalPages+')">'+pg.totalPages+'</button>'}
 h+='<button '+(pg.page>=pg.totalPages?"disabled":"")+' onclick="showCatPage(catId,'+(pg.page+1)+')">Next</button>';
 h+='<span class="pi">'+pg.total+' products</span></div>';c.innerHTML=h
}
function renderProductCardPC(pr,cn){
 var imgs=pr.images||[],ih="",dh="";
 if(imgs.length){ih=imgs.map(function(s,i){return'<img class="'+(i===0?"active":"inactive")+'" src="'+esc(s)+'" alt="'+esc(pr.name)+'" loading="lazy">'}).join("")}
 else ih='<div class="no-img">No image</div>';
 if(imgs.length>1){dh='<div class="card-dots">'+imgs.map(function(_,i){return'<span class="dot '+(i===0?"active":"")+'" data-dot="'+i+'"></span>'}).join("")+'</div>'}
 return'<div class="card" data-pid="'+esc(pr.id)+'" onclick="cardClick(this)"><div class="card-images">'+ih+dh+'</div><div class="card-header">'+esc(cn||pr.name)+'</div><div class="card-body"><p><strong>'+esc(pr.name)+'</strong></p>'+(pr.sku?'<p class="material">SKU: '+esc(pr.sku)+'</p>':'')+(pr.material?'<p class="material">'+esc(pr.material)+'</p>':'')+'</div></div>'
}
var pc=document.createElement("div");pc.id="pg-container";document.getElementById("products").appendChild(pc);


  loadProducts();

  var productObserver = new MutationObserver(function () {
    bindCardDots();
  });
  productObserver.observe(document.getElementById("products-container"), { childList: true, subtree: true });
</script>


