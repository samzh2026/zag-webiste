<body>

<header>
  <div class="logo-group">
    <a href="/" class="logo-text">ZAG <span>BRAKES</span></a>
    <div class="header-slogan">SAFETY IN EVERY STOP</div>
  </div>

  <nav>
    <div class="dropdown">
      <a class="dropbtn" id="nav-products">PRODUCTS &#9660;</a>
      <div class="dropdown-content" id="nav-dropdown">
        <!-- populated by JS -->
      </div>
    </div>
    <a href="#about" id="nav-about">ABOUT US</a>
    <a href="#contact" id="nav-contact">CONTACT</a>

    <div class="dropdown">
      <a class="lang-btn">&#127760; <span id="current-lang">English</span> &#9660;</a>
      <div class="dropdown-content">
        <a onclick="changeLang('en')">English</a>
        <a onclick="changeLang('cn')">&#20013;&#25991;</a>
        <a onclick="changeLang('tr')">T&#252;rk&#231;e</a>
        <a onclick="changeLang('es')">Espa&#241;ol</a>
        <a onclick="changeLang('pt')">Portugu&#234;s</a>
      </div>
    </div>
  </nav>
</header>

<section class="hero">
  <div class="hero-content">
    <p class="sub-text" id="hero-sub">LEADING CHINESE MANUFACTURER</p>
    <h2 id="hero-title">HIGH-PERFORMANCE<br>BRAKING SYSTEMS</h2>
    <p id="hero-desc" style="margin-top: 30px; font-size: 18px; max-width: 650px; font-family: Arial, sans-serif; font-weight: normal; opacity: 0.9;">
      Professional manufacturer of premium friction materials for ATV, UTV, and Motorcycles.
      Engineered for noiseless performance and ultimate safety.
    </p>
  </div>
</section>

<!-- Vehicle Search -->
<section class="search-section">
  <div class="search-box">
    <label>SEARCH BY EBC NO.
      <input type="text" id="searchPartInput" placeholder="e.g. FA123 or ZAG-PAD-F001">
    </label>
    <label>Make
      <select id="searchMakeSelect"><option value="">All Makes</option></select>
    </label>
    <label>Model
      <select id="searchModelSelect"><option value="">Select Make first</option></select>
    </label>
    <label>Year
      <select id="searchYearSelect"><option value="">Select Model first</option></select>
    </label>
    <button class="search-btn" id="searchBtn">Search</button>
  </div>
  <div class="search-results" id="searchResults"></div>
</section>

<section id="about" class="about-section">
  <div class="about-container">
    <div class="section-title" id="about-title">Professional Brake Solutions</div>
    <div class="about-text" id="about-content">
      <p><strong>ZAG BRAKES</strong> is a leading specialist in the manufacturing of high-performance braking components for the global powersports market. With a focus on <strong>Professionalism, High-Performance, and Safety</strong>, we provide world-class solutions for all major motorcycle brands.</p>
      <p>Our products are engineered to provide a <strong>Silent and Comfortable</strong> braking experience. Using advanced formulas, ZAG components ensure extreme durability.</p>
    </div>
  </div>
</section>

<section id="products" class="product-section">
  <div class="section-title" id="prod-title-main" style="margin-left: 0;">OUR PRODUCTS</div>
  <div id="products-container">
    <div class="loading">Loading products...</div>
  </div>
</section>

<section id="contact" style="padding: 60px 5%; background: var(--zag-black); color: white; text-align: center;">
  <div class="section-title" id="contact-title" style="color: white; border-color: var(--zag-red); display: inline-block;">GET IN TOUCH</div>
  <div style="margin: 30px 0; font-family: Arial, sans-serif; font-size: 18px;">
    <p>WhatsApp: <a href="https://wa.me/8613588158817" target="_blank" style="color:var(--zag-red);">+86 13588158817</a></p>
    <p>Email: <a href="mailto:info@ucanindustry.com" style="color:var(--zag-red);">info@ucanindustry.com</a></p>
  </div>
  <a href="mailto:info@ucanindustry.com" id="btn-inquiry" style="background: var(--zag-red); color: white; padding: 15px 40px; text-decoration: none; font-size: 18px; display: inline-block; font-family: 'Arial Black';">SEND INQUIRY</a>
</section>

<footer>
  <p>&copy; 2026 ZAG BRAKES. All Rights Reserved. Manufactured by UCAN INDUSTRIES.</p>
</footer>

