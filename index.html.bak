    tr: { desc: "ZAG BRAKES - Motosiklet, ATV ve UTV icin profesyonel fren balatasi, disk ve surtunme malzemeleri ureticisi.", keywords: "motosiklet fren balatasi, fren diskleri, ATV fren, UTV fren, sinter fren balatasi, seramik fren balatasi, ZAG BRAKES", title: "ZAG BRAKES | Profesyonel Fren Komponentleri Ureticisi" },
